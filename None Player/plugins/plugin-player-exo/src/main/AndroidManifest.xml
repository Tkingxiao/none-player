<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 后台播放：前台媒体服务 + 媒体通知（通知权限在 Android 13+ 由 PermissionProvider 聚合申请） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- exported 是 media3 MediaSessionService 的硬性要求：媒体按键 / MediaController
             绑定经由该 intent-filter，加 permission 会让系统媒体会话失联——刻意豁免。 -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- E157：不再声明 media3 的 MediaButtonReceiver。
             会话活着时，系统媒体键直接投给 MediaSession；PiP 的暂停/下一集走下面
             自建的 NpMediaActionReceiver。E209 已实现 onPlaybackResumption（系统媒体
             恢复卡）。但冷启动 MEDIA_BUTTON 仍不声明：没有恢复数据时该路径会先拉起
             前台服务再收到空播放指令，5s 内无可发通知会被系统杀进程（E156-1 实测）；
             系统恢复入口应由 SystemUI 的 resumption 卡走绑定，而不是媒体键广播。 -->
        <receiver
            android:name=".NpMediaActionReceiver"
            android:exported="false" />
    </application>

</manifest>
