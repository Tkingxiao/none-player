<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 后台播放：前台媒体服务 + 媒体通知（通知权限在 Android 13+ 由 PermissionProvider 聚合申请） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- exported 是 media3 MediaSessionService 的硬性要求：媒体按键 / MediaController
             绑定经由该 intent-filter，加 permission 会让系统媒体会话失联——刻意豁免。 -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- A2：媒体键入口。小窗（PiP）的暂停 / 下一集与耳机、蓝牙媒体键都经
             ACTION_MEDIA_BUTTON 广播到这里，它再按上面的 MediaSessionService intent-filter
             找到 PlaybackService，把按键交给会话侧播放器执行。
             exported 是硬性要求：按键由系统媒体栈发出，加 permission 会让耳机键失联——
             与 service 那条同一口径，刻意豁免。 -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
