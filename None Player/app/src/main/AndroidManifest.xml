<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 声明由 PermissionProvider 扩展点聚合申请的权限。
         音频权限与视频并列：媒体库现在同时收录音频（LocalMediaSource 的
         MediaStore.Audio 查询），只声明 READ_MEDIA_VIDEO 会让音频目录返回空。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Android 14+ 部分照片/视频访问：用户选择"仅 selected"时系统走此权限，
         声明后媒体库仍能看到用户勾选的项（SelectedPhotoAccess） -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- E233：API 26–29 没有「所有文件访问」与 MediaStore 删除请求，删除设备文件只能靠
         WRITE_EXTERNAL_STORAGE（直连 ContentResolver.delete）。API 30+ 起该权限失效，
         删除改走 SAF 写授权 / 「所有文件访问」，故这里以 maxSdkVersion=29 收口。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- 批次 6（plugin-danmaku）：同名弹幕/字幕文件是**非媒体文件**——scoped storage
         下只持 READ_MEDIA_* 的 app 在 MediaStore.Files 查询里根本看不到它们
         （实测 .xml/.ass 行对查询不可见，scanFile 也被拒索引）。声明
         MANAGE_EXTERNAL_STORAGE（"所有文件访问"，用户在系统设置里授予，
         由弹幕设置区块引导跳转）；授予后 DanmakuLocator 的直读路径兜底生效。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- E51：多窗口/分屏/自由窗口适配声明——应用可在任意窗口尺寸下运行，
         布局由 Compose 随窗口实时重算（NpWindowInfo 形态判定层） -->
    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:resizeable="true"
        android:smallScreens="true"
        android:xlargeScreens="true" />

    <!-- PictureInPictureIssue 定点豁免（本条不是攒账）：本模块没有自己的进小窗路径，
         手动入口与参数构建都在播放插件里——PlayerScreen.manualPipParams 已按检查要求
         调用 setSourceRectHint（进小窗从视频区域收拢过渡），autoEnter 保持 false 是
         "小窗只允许播放菜单手动进入"的产品决策（见 MainActivity.onPictureInPictureRequested
         与 disarmPictureInPicture 的注释）。app 模块的 lint 检查只分析本模块源码，看不到
         插件里的新式调用；若日后 app 模块自己新增 PiP 入口，先复核本条再谈移除。 -->
    <application
        android:name=".NonePlayerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NonePlayer"
        tools:ignore="PictureInPictureIssue">

        <!-- configChanges：旋转/窗口尺寸变化由 Compose 直接响应，
             不重建 Activity——避免旋转黑闪、播放状态与页面栈重置（E5）；
             layoutDirection 补入（E51 余项）：RTL 切换同样不重建；
             locale 补入（A2-9）：切语言同样不重建 Activity——布局档位由 LocalNpWindowInfo
             实时重算，重建反而会把播放会话与页面栈一起丢掉 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- E2 深链入口：noneplayer://player?uri=… 等由各插件
                 ScreenProvider.deepLinks 声明，经导航图 navDeepLink 分发（E26）；
                 singleTask + onNewIntent 保证应用在前台时也能被外部唤起 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="noneplayer" />
            </intent-filter>
        </activity>
    </application>

</manifest>
